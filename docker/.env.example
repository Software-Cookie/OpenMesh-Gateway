# Copy to docker/.env and adjust. Never commit the real .env file.
GATEWAY_PORT=8080
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

REDIS_PASSWORD=change-me-redis-password
IDENTITY_SIGNING_SECRET=change-me-to-a-long-random-secret
GRAFANA_ADMIN_PASSWORD=change-me

# 1 when Caddy/nginx runs in front of the gateway on the server, 0 for local use
TRUSTED_PROXY_HOPS=0

# Production only (docker-compose.prod.yml): your identity provider
# OPENMESH_JWT_JWK_SET_URI=https://YOUR-TENANT.auth0.com/.well-known/jwks.json
# OPENMESH_JWT_ISSUER=https://YOUR-TENANT.auth0.com/
# OPENMESH_JWT_AUDIENCE=https://api.openmesh
